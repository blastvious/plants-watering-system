# URL của Firebase Realtime Database của bạn
# Ví dụ: https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Đường dẫn đến file Service Account Key tải từ Firebase Console
# (Project Settings -> Service accounts -> Generate new private key)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Đặt true nếu muốn chạy chế độ giả lập (Mock) khi chưa cấu hình Firebase
USE_MOCK_FIREBASE=false

